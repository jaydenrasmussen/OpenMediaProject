FROM node:lts-slim

WORKDIR /app

# Install dependencies
COPY frontend/package*.json ./
RUN npm install

# Copy frontend source code (will be mounted in dev mode)
COPY frontend/ ./

# Expose Vite dev server port
EXPOSE 5173

# Run the development server with host set to 0.0.0.0 to allow external connections
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
