FROM golang:1.21-alpine

WORKDIR /app

# Install air for hot reload
RUN go install github.com/cosmtrek/air@latest

# Install dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy the entire project
COPY . .

# Expose port
EXPOSE 8080

# Run the application with hot reloading
CMD ["air", "-c", ".air.toml"]
