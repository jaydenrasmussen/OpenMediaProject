# Server settings
SERVER_ADDRESS=:8080
CORS_ALLOW_ORIGINS=*
APP_ENV=development
# Log level options: debug, info, warn, error
LOG_LEVEL=info

# Authentication settings
ENABLE_AUTH=true
API_KEY=your_api_key_here
ALLOW_API_KEY_QUERY=false
SKIP_AUTH_ENDPOINTS=/api/health,/api/v1/health

# Database settings
DB_PATH=./data/nutsdb

# API Keys
TVDB_API_KEY=your_tvdb_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here

# Torrent Client Configuration
# Choose one of: rutorrent, transmission, deluge
TORRENT_CLIENT_TYPE=rutorrent
TORRENT_CLIENT_URL=http://your_torrent_client_url
TORRENT_CLIENT_USERNAME=your_username
TORRENT_CLIENT_PASSWORD=your_password

# Legacy ruTorrent configuration (for backward compatibility)
RUTORRENT_URL=http://your_rutorrent_url
RUTORRENT_USERNAME=your_username
RUTORRENT_PASSWORD=your_password
